{
    "comments": {
      "lineComment": "//"
    },
    "brackets": [
      ["(", ")"]
    ],
    "autoClosingPairs": [
      { "open": "(", "close": ")" },
      { "open": "'", "close": "'" }
    ],
    "surroundingPairs": [
      ["(", ")"],
      ["'", "'"]
    ],
    "indentationRules": {
      "increaseIndentPattern": "^(PARAMETERS:|RULES:)\\s*$",
      "decreaseIndentPattern": "^END\\b"
    }
  }