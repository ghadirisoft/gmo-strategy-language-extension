      "description": "کمترین اعتماد سیگنال در N سیگنال آخر"
    },      
    "AVG PRICE": {
      "prefix": "gmo-avg-price",
      "body": ["AVG_PRICE(${1|GREEN,BLUE,YELLOW,RED|}, ${2:5})"],
      "description": "میانگین اعتماد N سیگنال آخر"
    },   


    "Max Confidence": {
      "prefix": "gmo-max-conf",
      "body": ["MAX_CONFIDENCE(${1|GREEN,BLUE,YELLOW,RED|}, ${2:5})"],
      "description": "بیشترین اعتماد سیگنال در N سیگنال آخر"
