{
    "Strategy Template": {
      "prefix": "gmo-strategy",
      "body": [
        "STRATEGY ${1:MyStrategy}",
        "",
        "VERSION ${2:1.0}",
        "DESCRIPTION: ${3:توضیح اختیاری}",
        "",
        "PARAMETERS:",
        "  SIGNAL     = FIELD(0)",
        "  CONFIDENCE = FIELD(1)",
        "  DATETIME   = FIELD(2) + ' ' + FIELD(4)",
        "  PRICE      = FIELD(5)",
        "  GMOML      = FIELD(6)",
        "  MARKET     = FIELD(7)",
        "  FACTOR     = FIELD(8)",
        "  TRADERS    = FIELD(9)",
        "  PIVOTPOINT = FIELD(10)",
        "",
        "RULES:",
        "  SIGNAL = GREEN -> BUY(${4:1G})",
        "  SIGNAL = BLUE -> BUY(${5:1G})",        
        "  SIGNAL = YELLOW   -> SELL(${6:1G})",
        "  SIGNAL = RED   -> SELL(${7:1G})",                
        "",
        "END"
      ],
      "description": "قالب پایه‌ی استراتژی GMO"
    },"Strategy Token Template": {
      "prefix": "gmo-strategy-token",
      "body": [
        "STRATEGY ${1:MyStrategy}",
        "",
        "VERSION token",
        "REVISION ${2:1.0}",
        "",
        "DESCRIPTION: ${3:توضیح اختیاری}",
        "PUBLISHER: ${4:نام ناشر در  Strategy Hub}",            
        "",
        "TOKEN: ${5:توکن ۶۴ کاراکتری دریافت شده از  Strategy Hub}",
        "",
        "END"
      ],
      "description": "قالب پایه‌ی استراتژی مبتنی بر توکن"
    },   
    "Buy Rule": {
      "prefix": "gmo-buy",
      "body": ["SIGNAL = ${1|GREEN,BLUE,YELLOW,RED|} -> BUY(${2:1G}) IF ${3:CONFIDENCE > 70}"],
      "description": "قانون خرید"
    },
    "Sell Rule": {
      "prefix": "gmo-sell",
      "body": ["SIGNAL = ${1|GREEN,BLUE,YELLOW,RED|} -> SELL(${2:1G}) IF ${3:PRICE > 5000000}"],
      "description": "قانون فروش"
    },
    "Buy Multi-Source": {
      "prefix": "gmo-buy-multi",
      "body": ["SIGNAL = ${1|GREEN,BLUE,YELLOW,RED|} -> BUY(${2|GREEN,BLUE,YELLOW,RED|}:${3:0.5G}, ${4|GREEN,BLUE,YELLOW,RED|}:${5:0.5G})"],
      "description": "خرید در چند منبع"
    },
    "Sell Multi-Source": {
      "prefix": "gmo-sell-multi",
      "body": ["SIGNAL = ${1|GREEN,BLUE,YELLOW,RED|} -> SELL(${2|GREEN,BLUE,YELLOW,RED|}:${3:0.5G}, ${4|GREEN,BLUE,YELLOW,RED|}:${5:0.5G})"],
      "description": "فروش از چند منبع"
    },

    "Last Confidence": {
      "prefix": "gmo-last-conf",
      "body": ["LAST_CONFIDENCE(${1|GREEN,BLUE,YELLOW,RED|})"],
      "description": "آخرین اعتماد سیگنال"
    },
    "Last PRICE": {
      "prefix": "gmo-last-price",
      "body": ["LAST_PRICE(${1|GREEN,BLUE,YELLOW,RED|})"],
      "description": "آخرین قیمت سیگنال"
    },    
    "Last Datetime": {
      "prefix": "gmo-last-dt",
      "body": ["LAST_DATETIME(${1|GREEN,BLUE,YELLOW,RED|}, ${2:36H})"],
      "description": "آخرین تاریخ/ساعت سیگنال با offset"
    },

    "Max PRICE": {
      "prefix": "gmo-max-pricef",
      "body": ["MAX_PRICE(${1|GREEN,BLUE,YELLOW,RED|}, ${2:5})"],
      "description": "بیشترین اعتماد سیگنال در N سیگنال آخر"
    },    
    "Min PRICE": {
      "prefix": "gmo-min-price",
