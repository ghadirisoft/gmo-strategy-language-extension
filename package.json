{
  "name": "gmo-strategy",
  "displayName": "GMO Strategy Language",
  "description": "GMO Strategy language support (Strategy Hub + simulation execution)",
  "version": "2.0.0",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/ghadirisoft/gmo-strategy-language-extension.git"
  },
  "publisher": "ghadirisoft",
  "bugs": {
    "url": "https://github.com/ghadirisoft/gmo-strategy-language-extension/issues"
  },
  "homepage": "https://github.com/ghadirisoft/gmo-strategy-language-extension#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "gmo",
    "gold",
    "trading",
    "strategy",
    "backtest",
    "gmo-strategy",
    "goldai",
    "hub",
    "طلا",
    "استراتژی",
    "معاملات",
    "بک‌تست",
    "مخزن"
  ],
  "activationEvents": [
    "onLanguage:gmo",
    "onCommand:gmo.runStrategy",
    "onCommand:gmo.runBacktest",
    "onCommand:gmo.login",
    "onCommand:gmo.logout",
    "onCommand:gmo.formatDocument",
    "onCommand:gmo.refreshDiagnostics",
    "onView:gmoHubView",
    "onCommand:gmo.hub.refresh",
    "onCommand:gmo.hub.openStrategy",
    "onCommand:gmo.hub.saveToHub",
    "onCommand:gmo.hub.refreshFromHub",
    "onCommand:gmo.hub.disconnect",
    "onCommand:gmo.hub.showDetails"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gmo",
        "aliases": [
          "GMO Strategy",
          "gmo"
        ],
        "extensions": [
          ".gmo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gmo",
        "scopeName": "source.gmo",
        "path": "./syntaxes/gmo.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gmo",
        "path": "./snippets/gmo.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gmoHubContainer",
          "title": "GMO Strategy Hub",
          "icon": "media/gmo-hub-icon.svg"
        }
      ]
    },
    "views": {
      "gmoHubContainer": [
        {
          "id": "gmoHubView",
          "name": "استراتژی‌ها",
          "icon": "media/gmo-hub-icon.svg",
          "contextualTitle": "GMO Strategy Hub"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gmoHubView",
        "contents": "برای مشاهده استراتژی‌های خود وارد شوید.\n[GMO ورود به](command:gmo.login)\n\nپس از ورود، هم شبیه‌ساز و هم مخزن استراتژی در دسترس خواهند بود."
      }
    ],
    "commands": [
      {
        "command": "gmo.runBacktest",
        "title": "GMO: Run Backtest",
        "category": "GMO",
        "icon": "$(beaker)"
      },
      {
        "command": "gmo.login",
        "title": "GMO: Login",
        "category": "GMO",
        "icon": "$(account)"
      },
      {
        "command": "gmo.logout",
        "title": "GMO: Logout",
        "category": "GMO",
        "icon": "$(sign-out)"
      },
      {
        "command": "gmo.formatDocument",
        "title": "GMO: Format Document",
        "category": "GMO",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "gmo.refreshDiagnostics",
        "title": "GMO: Refresh Diagnostics",
        "category": "GMO",
        "icon": "$(refresh)"
      },
      {
        "command": "gmo.hub.refresh",
        "title": "GMO Hub: Refresh",
        "category": "GMO Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "gmo.hub.openStrategy",
        "title": "GMO Hub: Open Strategy",
        "category": "GMO Hub",
        "icon": "$(file-code)"
      },
      {
        "command": "gmo.hub.saveToHub",
        "title": "GMO Hub: Save to Hub",
        "category": "GMO Hub",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gmo.hub.refreshFromHub",
        "title": "GMO Hub: Refresh from Hub",
        "category": "GMO Hub",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gmo.hub.disconnect",
        "title": "GMO Hub: Disconnect",
        "category": "GMO Hub",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "gmo.hub.showDetails",
        "title": "GMO Hub: Show Details",
        "category": "GMO Hub",
        "icon": "$(info)"
      },
      {
        "command": "gmo.runStrategy",
        "title": "GMO: Run Strategy",
        "category": "GMO",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gmo.hub.refresh",
          "when": "view == gmoHubView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gmo.hub.openStrategy",
          "when": "view == gmoHubView && viewItem == gmoHubStrategy",
          "group": "1_open@1"
        },
        {
          "command": "gmo.hub.saveToHub",
          "when": "view == gmoHubView && viewItem == gmoHubStrategy",
          "group": "2_sync@1"
        },
        {
          "command": "gmo.hub.refreshFromHub",
          "when": "view == gmoHubView && viewItem == gmoHubStrategy",
          "group": "2_sync@2"
        },
        {
          "command": "gmo.hub.disconnect",
          "when": "view == gmoHubView && viewItem == gmoHubStrategy",
          "group": "2_sync@3"
        },
        {
          "command": "gmo.hub.showDetails",
          "when": "view == gmoHubView && viewItem == gmoHubStrategy",
          "group": "3_details@1"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == gmo",
          "command": "gmo.runBacktest",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId == gmo",
          "command": "gmo.hub.saveToHub",
          "group": "1_modification@1"
        },
        {
          "when": "editorLangId == gmo",
          "command": "gmo.hub.disconnect",
          "group": "1_modification@2"
        },
        {
          "when": "editorLangId == gmo",
          "command": "gmo.formatDocument",
          "group": "1_modification@3"
        },
        {
          "when": "editorLangId == gmo",
          "command": "gmo.refreshDiagnostics",
          "group": "1_modification@4"
        },
        {
          "when": "editorLangId == gmo",
          "command": "gmo.runStrategy",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gmo.runBacktest",
          "when": "editorLangId == gmo"
        },
        {
          "command": "gmo.formatDocument",
          "when": "editorLangId == gmo"
        },
        {
          "command": "gmo.refreshDiagnostics",
          "when": "editorLangId == gmo"
        },
        {
          "command": "gmo.hub.saveToHub",
          "when": "editorLangId == gmo"
        },
        {
          "command": "gmo.hub.disconnect",
          "when": "editorLangId == gmo"
        },
        {
          "command": "gmo.hub.openStrategy"
        },
        {
          "command": "gmo.hub.showDetails"
        },
        {
          "command": "gmo.hub.refresh"
        },
        {
          "command": "gmo.login"
        },
        {
          "command": "gmo.logout"
        },
        {
          "command": "gmo.runStrategy",
          "when": "editorLangId == gmo"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gmo.runBacktest",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == gmo"
      },
      {
        "command": "gmo.formatDocument",
        "key": "shift+alt+f",
        "mac": "shift+option+f",
        "when": "editorLangId == gmo"
      },
      {
        "command": "gmo.hub.saveToHub",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorLangId == gmo"
      },
      {
        "command": "gmo.runStrategy",
        "key": "f5",
        "mac": "f5",
        "when": "editorLangId == gmo"
      }
    ],
    "themes": [
      {
        "label": "GMO Strategy",
        "uiTheme": "vs",
        "path": "./themes/gmo-color-theme.json"
      }
    ],
    "configuration": {
      "title": "GMO Strategy",
      "properties": {
        "gmo.format.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "تعداد فاصله برای تورفتگی (اگر Use Tabs فعال نباشد)."
        },
        "gmo.format.useTabs": {
          "type": "boolean",
          "default": false,
          "description": "استفاده از Tab به‌جای فاصله برای تورفتگی."
        },
        "gmo.format.alignAssignments": {
          "type": "boolean",
          "default": true,
          "description": "تراز کردن علامت '=' در بخش PARAMETERS."
        },
        "gmo.format.alignArrow": {
          "type": "boolean",
          "default": true,
          "description": "تراز کردن '->' در بخش RULES."
        },
        "gmo.format.uppercaseKeywords": {
          "type": "boolean",
          "default": true,
          "description": "تبدیل کلیدواژه‌ها و نام متغیرها به حروف بزرگ."
        },
        "gmo.format.addSpaceAroundOperators": {
          "type": "boolean",
          "default": true,
          "description": "قرار دادن فاصله یکنواخت دور عملگرها."
        },
        "gmo.format.trimTrailingSpaces": {
          "type": "boolean",
          "default": true,
          "description": "حذف فاصله‌های انتهای خطوط."
        },
        "gmo.format.finalNewline": {
          "type": "boolean",
          "default": true,
          "description": "افزودن یک خط خالی در انتهای فایل."
        },
        "gmo.runBacktest.autoFormat": {
          "type": "boolean",
          "default": true,
          "description": "قالب‌بندی خودکار استراتژی قبل از ارسال به شبیه‌ساز."
        },
        "gmo.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "فعال بودن خطایابی زنده (Diagnostics)."
        },
        "gmo.diagnostics.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "مدت تأخیر (میلی‌ثانیه) قبل از اجرای خطایابی پس از تایپ."
        },
        "gmo.diagnostics.showWarnings": {
          "type": "boolean",
          "default": true,
          "description": "نمایش هشدارها (Warning) در کنار خطاها (Error)."
        },
        "gmo.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "فعال بودن نمایش Tooltip (Hover)."
        },
        "gmo.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "فعال بودن تکمیل خودکار (IntelliSense)."
        },
        "gmo.inlayHints.showFieldMeaning": {
          "type": "boolean",
          "default": true,
          "description": "نمایش معنی FIELD(n) کنار آن (مثلاً «اعتماد»)."
        },
        "gmo.inlayHints.showReturnType": {
          "type": "boolean",
          "default": false,
          "description": "نمایش نوع خروجی توابع آماری (عدد/تاریخ)."
        },
        "gmo.inlayHints.showParamType": {
          "type": "boolean",
          "default": true,
          "description": "نمایش نوع مقدار پارامترها (عدد/رشته/تاریخ)."
        },
        "gmo.hub.enabled": {
          "type": "boolean",
          "default": true,
          "description": "فعال بودن اتصال به GMO Strategy Hub. اگر غیرفعال شود، Sidebar و دستورات مخزن نمایش داده نمی‌شوند و هیچ درخواست شبکه‌ای به مخزن ارسال نمی‌شود."
        },
        "gmo.hub.downloadFolder": {
          "type": "string",
          "default": "",
          "description": "پوشهٔ ذخیرهٔ فایل‌های استراتژی دریافت‌شده از مخزن. اگر خالی باشد، از پوشهٔ .gmo-hub در workspace (یا temp اگر workspace نباشد) استفاده می‌شود."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.double-slash.gmo",
            "settings": {
              "foreground": "#8a94a3",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "keyword.control.gmo",
            "settings": {
              "foreground": "#af00db",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.language.signal-green.gmo",
            "settings": {
              "foreground": "#1f9d55",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.language.signal-red.gmo",
            "settings": {
              "foreground": "#d63031",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.language.signal-blue.gmo",
            "settings": {
              "foreground": "#2c6fbb",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.language.signal-yellow.gmo",
            "settings": {
              "foreground": "#b8860b",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.function.action.buy.gmo",
            "settings": {
              "foreground": "#16825d",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.function.action.sell.gmo",
            "settings": {
              "foreground": "#c72e2e",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.function.gmo",
            "settings": {
              "foreground": "#a8832e"
            }
          },
          {
            "scope": "variable.other.gmo",
            "settings": {
              "foreground": "#5a4fcf"
            }
          },
          {
            "scope": "constant.numeric.gmo",
            "settings": {
              "foreground": "#0a7b83"
            }
          },
          {
            "scope": "string.quoted.single.gmo",
            "settings": {
              "foreground": "#6b4f2e"
            }
          },
          {
            "scope": "keyword.operator.gmo",
            "settings": {
              "foreground": "#7a7f87"
            }
          },
          {
            "scope": "keyword.operator.logical.gmo",
            "settings": {
              "foreground": "#0a2b5c",
              "fontStyle": "bold"
            }
          }
        ]
      },
      "editor.inlayHints.enabled": "onUnlessPressed"
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "lint": "node -c extension.js && node -c formatter.js && node -c parser.js && node -c codes.js && node -c definition-provider.js && node -c hover-provider.js && node -c reference-provider.js && node -c rename-provider.js && node -c diagnostic-provider.js && node -c completion-provider.js && node -c code-action-provider.js && node -c document-symbol-provider.js && node -c folding-provider.js && node -c signature-help-provider.js && node -c inlay-hints-provider.js && node -c hub/hub-constants.js && node -c hub/hub-errors.js && node -c hub/hub-client.js && node -c hub/hub-cache.js && node -c hub/hub-session.js && node -c views/hub-tree-provider.js && node -c commands/_helpers.js && node -c commands/hub-refresh.js && node -c commands/hub-open-strategy.js && node -c commands/hub-save-to-hub.js && node -c commands/hub-refresh-from-hub.js && node -c commands/hub-disconnect.js && node -c commands/hub-show-details.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}