STRATEGY ProfitableSale (Fork)
VERSION 1.2

PARAMETERS:
  SIGNAL = FIELD(0)
  PRICE  = FIELD(5)
  CONFIDENCE     = FIELD(1)

RULES:
  SIGNAL = GREEN  -> BUY(1G) IF CONFIDENCE > LAST_CONFIDENCE(GREEN)
  SIGNAL = BLUE   -> BUY(1G) IF CONFIDENCE > LAST_CONFIDENCE(BLUE)
  SIGNAL = YELLOW -> SELL(1G) IF PRICE > LAST_PRICE(BLUE) + ((LAST_PRICE(BLUE) * 1) / 100)
  SIGNAL = RED    -> SELL(1G) IF PRICE > LAST_PRICE(GREEN) + ((LAST_PRICE(GREEN) * 1) / 100)
END