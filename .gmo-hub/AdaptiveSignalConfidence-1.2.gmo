STRATEGY AdaptiveSignalConfidence
VERSION 1.2

DESCRIPTION: استراتژی معاملاتی مبتنی بر سیگنال‌های رنگی (خرید/فروش) با مقیاس‌بندی پویای حجم بر اساس درجه اطمینان و روند تغییر آن نسبت به سیگنال قبلی. حجم معامله در سه سطح بر اساس آستانه‌های درجه اطمینان تعیین می‌شود.

PARAMETERS:
        SIGNAL     = FIELD(0)
        CONFIDENCE = FIELD(1)

RULES:
    // ═══════════ سیگنال سبز (GREEN) ═══════════
        SIGNAL = GREEN  -> BUY(0.5G) IF CONFIDENCE < 40 AND CONFIDENCE >= LAST_CONFIDENCE(GREEN)
        SIGNAL = GREEN  -> BUY(1G) IF CONFIDENCE >= 40 AND CONFIDENCE <= 50 AND CONFIDENCE >= LAST_CONFIDENCE(GREEN)
        SIGNAL = GREEN  -> BUY(2G) IF CONFIDENCE > 50 AND (CONFIDENCE >= LAST_CONFIDENCE(GREEN) OR CONFIDENCE >= LAST_CONFIDENCE(BLUE))

    // ═══════════ سیگنال آبی (BLUE) ═══════════
        SIGNAL = BLUE   -> BUY(0.5G) IF CONFIDENCE < 40 AND CONFIDENCE >= LAST_CONFIDENCE(BLUE)
        SIGNAL = BLUE   -> BUY(1G) IF CONFIDENCE >= 40 AND CONFIDENCE <= 50 AND CONFIDENCE >= LAST_CONFIDENCE(BLUE)
        SIGNAL = BLUE   -> BUY(2G) IF CONFIDENCE > 50 AND (CONFIDENCE >= LAST_CONFIDENCE(GREEN) OR CONFIDENCE >= LAST_CONFIDENCE(BLUE))

    // ═══════════ سیگنال زرد (YELLOW) ═══════════
        SIGNAL = YELLOW -> SELL(0.5G) IF CONFIDENCE < 40 AND CONFIDENCE >= LAST_CONFIDENCE(YELLOW)
        SIGNAL = YELLOW -> SELL(1G) IF CONFIDENCE >= 40 AND CONFIDENCE <= 50 AND CONFIDENCE >= LAST_CONFIDENCE(YELLOW)
        SIGNAL = YELLOW -> SELL(2G) IF CONFIDENCE > 50 AND (CONFIDENCE >= LAST_CONFIDENCE(RED) OR CONFIDENCE >= LAST_CONFIDENCE(YELLOW))

    // ═══════════ سیگنال قرمز (RED) ═══════════
        SIGNAL = RED    -> SELL(0.5G) IF CONFIDENCE < 40 AND CONFIDENCE >= LAST_CONFIDENCE(RED)
        SIGNAL = RED    -> SELL(1G) IF CONFIDENCE >= 40 AND CONFIDENCE <= 50 AND CONFIDENCE >= LAST_CONFIDENCE(RED)
        SIGNAL = RED    -> SELL(2G) IF CONFIDENCE > 50 AND (CONFIDENCE >= LAST_CONFIDENCE(RED) OR CONFIDENCE >= LAST_CONFIDENCE(YELLOW))
END
